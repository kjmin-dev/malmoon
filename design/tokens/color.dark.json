{
  "color": {
    "$type": "color",
    "background": {
      "base": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0549, 0.0549, 0.0667],
          "hex": "#0e0e11"
        },
        "$description": "Page background."
      },
      "surface": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0941, 0.0941, 0.1098],
          "hex": "#18181c"
        },
        "$description": "Cards and panels on top of the page."
      }
    },
    "text": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.949, 0.949, 0.9608],
          "hex": "#f2f2f5"
        }
      },
      "secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6627, 0.6627, 0.7059],
          "hex": "#a9a9b4"
        }
      },
      "on-accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        },
        "$description": "Text on an accent-colored surface."
      }
    },
    "border": {
      "default": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1725, 0.1725, 0.2],
          "hex": "#2c2c33"
        }
      }
    },
    "accent": {
