        "$value": {
          "colorSpace": "srgb",
          "components": [0.9765, 0.4392, 0.4],
          "hex": "#f97066"
        }
      },
      "success": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2784, 0.8039, 0.5373],
          "hex": "#47cd89"
        }
      },
      "warning": {
        "$value": {
          "colorSpace": "srgb",
