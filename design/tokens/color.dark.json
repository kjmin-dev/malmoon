        "$value": {
          "colorSpace": "srgb",
          "components": [0.5529, 0.6353, 0.9843],
          "hex": "#8da2fb"
        }
      },
      "zero-retention": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4, 0.851, 0.9098],
          "hex": "#66d9e8"
        }
      },
      "confidential": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.898, 0.6, 0.9686],
          "hex": "#e599f7"
        }
      }
    }
