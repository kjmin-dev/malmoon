{
  "color": {
    "$type": "color",
    "background": {
      "base": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        },
        "$description": "Page background."
      },
      "surface": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9608, 0.9608, 0.9686],
          "hex": "#f5f5f7"
        },
        "$description": "Cards and panels on top of the page."
      }
    },
    "text": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0863, 0.0863, 0.102],
          "hex": "#16161a"
        }
      },
      "secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3608, 0.3608, 0.4],
          "hex": "#5c5c66"
        }
      },
      "on-accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        },
        "$description": "Text on an accent-colored surface."
      }
    },
    "border": {
      "default": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8863, 0.8863, 0.9098],
          "hex": "#e2e2e8"
        }
      }
    },
    "accent": {
      "default": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3098, 0.2745, 0.898],
          "hex": "#4f46e5"
        },
        "$description": "Primary actions and focus."
      }
    },
    "status": {
      "danger": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.851, 0.1765, 0.1255],
          "hex": "#d92d20"
        }
      },
      "success": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0235, 0.4627, 0.2784],
          "hex": "#067647"
        }
      },
      "warning": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7098, 0.2784, 0.0314],
          "hex": "#b54708"
        }
      }
    },
    "data-path": {
      "$description": "Badge colors for the three data paths a session can use.",
      "standard": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2314, 0.3569, 0.8588],
          "hex": "#3b5bdb"
        }
      },
      "zero-retention": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0431, 0.4471, 0.5216],
          "hex": "#0b7285"
        }
      },
      "confidential": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5255, 0.1804, 0.6118],
          "hex": "#862e9c"
        }
      }
    }
  }
}
